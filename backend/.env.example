# 醒伴 WakeMate Backend · 环境变量模板（更新版）
# cp .env.example .env  然后填入真实值

# ── 应用 ────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── 数据库 ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://wakemate:password@localhost:5432/wakemate_db

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── xiaozhi-server ──────────────────────────────────────────────
# [IS_MOCK_MODE 开关] true=本地 mock 不连真实服务，false=连接真实 xiaozhi-server
XIAOZHI_MOCK_MODE=true
XIAOZHI_WS_URL=wss://your-xiaozhi-server.com/ws
XIAOZHI_API_KEY=your-xiaozhi-api-key
XIAOZHI_DEFAULT_MODEL=xiaoxing-v1

# ── FCM 推送 ────────────────────────────────────────────────────
FCM_CREDENTIALS_FILE=./firebase-credentials.json

# ── 漏服超时（秒）───────────────────────────────────────────────
# 生产：1800（30分钟）; 演示：120（2分钟）
MISSED_DOSE_TIMEOUT_SECONDS=1800

# ── 硬件商城 ────────────────────────────────────────────────────
# [IS_MOCK_MODE 开关] true=内置 Mock SKU，false=对接真实打印供应商
SHOP_MOCK_MODE=true
# 真实供应商 API（SHOP_MOCK_MODE=false 时填写）
SHOP_SUPPLIER_API_URL=https://your-3d-print-supplier.com/api
SHOP_SUPPLIER_API_KEY=your-supplier-key

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── 日志 ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
